# Auth0 SPA credentials — copy to .env.local and fill in values from Auth0 dashboard
# Application type: Single Page Application
# Allowed Callback URLs: http://localhost:5173, https://your-render-domain.onrender.com
# Allowed Logout URLs:   http://localhost:5173, https://your-render-domain.onrender.com
# Allowed Web Origins:   http://localhost:5173, https://your-render-domain.onrender.com

VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=https://partneriq.api
