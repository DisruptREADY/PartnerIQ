# Auth0 backend credentials — set these as environment variables in Render
# Create an API in Auth0 dashboard:
#   Identifier (audience): https://partneriq.api
#   Signing Algorithm:     RS256

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://partneriq.api

# Federal data API keys (optional — public endpoints work without them)
BLS_API_KEY=
CENSUS_API_KEY=
