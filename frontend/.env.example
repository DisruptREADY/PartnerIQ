# Auth0 SPA credentials — copy to .env.local and fill in values from Auth0 dashboard
# Application type: Single Page Application
# Allowed Callback URLs: http://localhost:5173, https://partneriq.com
# Allowed Logout URLs:   http://localhost:5173, https://partneriq.com
# Allowed Web Origins:   http://localhost:5173, https://partneriq.com

VITE_AUTH0_DOMAIN=disruptready.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=https://partneriq.api
